# 复制为 ~/.dsh/trading.env 后填写，并确保权限为 chmod 600 ~/.dsh/trading.env。
# 本文件只提供变量名/默认值示例；不要把真实凭据提交到仓库或 unit。

TRADER_API_KEY=
TRADER_API_SECRET=

# 运行模式：paper | live_auto；默认 paper。实盘前置与限额见 plan.md §8/§12。
# live_auto 还须独立 TRADER_LIVE_ARMED=1、完整限额及两项凭据，否则拒绝启动。
TRADER_MODE=paper
TRADER_LIVE_ARMED=0

# HTX 现货与 USDT 永续账户分离；本策略默认使用永续账户。
TRADER_ACCOUNT_TYPE=swap
TRADER_VENUE=htx

# Node 全局 fetch 读取代理环境；没有代理时保持为空，并按本机网络策略设置。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
NODE_USE_ENV_PROXY=1
