# 复制为 ~/.dsh/trading.env 后填写，并确保权限为 chmod 600 ~/.dsh/trading.env。
# 本文件只提供变量名/默认值示例；不要把真实凭据提交到仓库或 unit。

TRADER_API_KEY=
TRADER_API_SECRET=

# 运行模式：paper | live_confirm | live_auto。**默认 paper**（红线）。
# live_auto = 无人值守实盘（没有人确认就下单）。改这里等于改启动参数，重启服务后生效；
# 交互式运行则用 `TRADER_MODE=live_auto dsh --profile trade`。非法值会拒绝启动。
TRADER_MODE=paper

# HTX 现货与 USDT 永续账户分离；本策略默认使用永续账户。
TRADER_ACCOUNT_TYPE=swap
TRADER_VENUE=htx

# Node 全局 fetch 读取代理环境；没有代理时保持为空，并按本机网络策略设置。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
NODE_USE_ENV_PROXY=1
