[Unit]
Description=DISABLED DSH Trader external watchdog (Docker owns process lifetime)
RefuseManualStart=yes
ConditionPathExists=/dev/null/dsh-trader-watchdog-never

# 保留这个 unit 只为让旧 systemd 部署在升级时显式失败；当前部署是 Docker 单进程，
# dsh 退出后由容器 restart policy 重启，不能再启动第二个撤单进程。

[Service]
Type=oneshot
ExecStart=/usr/bin/false
Restart=no

[Install]
WantedBy=multi-user.target
