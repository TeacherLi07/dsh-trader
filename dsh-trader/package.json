{
  "name": "dsh-trader",
  "version": "0.0.1",
  "private": true,
  "description": "7x24 unattended crypto trading agent for DeepSeek Harness (paper -> testnet -> live)",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./plugins/db": "./lib/plugins/db.js",
    "./plugins/market": "./lib/plugins/market.js",
    "./plugins/rules": "./lib/plugins/rules.js",
    "./plugins/exec": "./lib/plugins/exec.js",
    "./plugins/supervisor": "./lib/plugins/supervisor.js",
    "./plugins/predictions": "./lib/plugins/predictions.js",
    "./plugins/commands": "./lib/plugins/commands.js",
    "./plugins/probe": "./lib/plugins/probe.js",
    "./plugins/ui": "./lib/plugins/ui.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm build && pnpm test",
    "link:peers": "node scripts/link-peers.mjs",
    "clean": "rm -rf lib coverage"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ccxt": "^4.5.78",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
